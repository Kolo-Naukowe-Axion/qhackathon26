  "code_excerpt": "119      for meal in meals:\n120          a,b=meal[\"main\"],meal[\"side\"]\n121          constant+=weights[\"W\"]*(fixed_coverage[a]+fixed_coverage[b])\n122          for i in cover[a]+cover[b]:linear[i]+=weights[\"W\"]\n123          product(a,b,-weights[\"U\"]*meal[\"priority\"]-2*weights[\"W\"])\n124      objective_pairs={key:value for key,value in pairs.items() if value}\n125      objective_linear=linear.copy();objective_constant=constant\n126      span=sum(abs(c) for c in linear)+sum(abs(c) for c in objective_pairs.values())\n127      penalty=span+1\n128      membership={i:j for j,g in enumerate(groups) for i in g[\"program_indices\"]}",
